<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>kinova_dual_arm_dmp_insertion</name>
  <version>0.1.0</version>
  <description>Dual-arm Kinova insertion of a tetromino into a narrowed shelf slot along a DMP route trained in PyBullet, with the SOCP squeeze (TP-GMM prior) closed on wrist F/T.</description>
  <maintainer email="lorenzopen3@gmail.com">Lorenzo</maintainer>
  <license>Proprietary</license>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>pinocchio</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-scipy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
